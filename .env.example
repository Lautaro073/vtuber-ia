# Copiá este archivo como .env y completá los valores.

# Murf TTS: murf.ai → Dashboard → API Keys. Sin key se usa Edge TTS (gratis).
MURF_API_KEY=

# Kick (API oficial): kick.com → Configuración → Developer → crear app
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# URL pública del túnel (Cloudflare Tunnel / ngrok) que apunta a http://localhost:3000
# En la app de Kick, poné como Webhook URL: <PUBLIC_URL>/webhooks/kick
PUBLIC_URL=

# Contraseña del panel y la API. El OBS no la necesita. Vacía = sin contraseña.
PANEL_PASSWORD=

# Motor de voz: murf (API paga) | edge (gratis, Microsoft) | system (voz de Windows)
TTS_ENGINE=murf
# Voz de Edge (ej: es-AR-ElenaNeural, es-AR-TomasNeural, es-MX-DaliaNeural)
EDGE_VOICE=es-AR-ElenaNeural

# Segundos sin actividad para que NYRA tire un dato curioso en el live (0 = apagado)
IDLE_FACT_SECONDS=60

# Minutos entre recordatorios de metas/tribunal en el live (0 = apagado)
PROMO_MINUTES=6

# Minutos entre reconexiones automáticas a TikTok (a veces deja de mandar el chat de algunos; 0 = apagado)
TIKTOK_REFRESH_MINUTES=30

# Proveedor habilitado en el primer arranque: agy | claude | codex | opencode.
# Después, los checkboxes del panel guardan qué proveedores quedan encendidos.
NYRA_ENGINE=agy
CLAUDE_MODEL=claude-haiku-5-5
# Rutas opcionales si los comandos no están en PATH.
CODEX_PATH=codex
OPENCODE_PATH=opencode
# Modelo de agy (si usás NYRA_ENGINE=agy)
AGY_MODEL=gemini-4-neon-low
# Modelo de la visión de pantalla: claude-code:<modelo> (rápido, cuota de Claude) o uno de agy como gemini-3.8-flash-low (lento, cuota de Gemini)
VISION_MODEL=claude-code:claude-haiku-5-5-low

# Cómo se llama el streamer (NYRA lo reconoce en lo que escribís en el panel)
STREAMER_NAME=El Yisus Pai
STREAMER_ALIAS=el Yisus

# Discord: bot de voz (prueba: node scripts/discord-prueba.mjs). El token no se comparte con nadie
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
# Solo si el streamer no es quien creó el bot de Discord
STREAMER_DISCORD_ID=
# Tu @ de TikTok: lo que escribas ahí en el chat cuenta como el streamer
STREAMER_TIKTOK=elyisuspai696

# NYRA busca en internet cuando le discuten un dato (solo busqueda, temas limitados). 0 = apagado
NYRA_RESEARCH=1

# Prioridad técnica configurable (desactivada por defecto para los demás modelos).
# Activación por modelo (ID exacto de ProviderRegistry, ej: opencode:nyra-ollama/nyra):
# Para desactivarla, dejá NYRA_TECH_MODELS vacío o seteá NYRA_TECH_PRIORITY=0. Para forzarla en todos: NYRA_TECH_PRIORITY=1.
NYRA_TECH_MODELS=opencode:nyra-ollama/nyra
# NYRA_TECH_PRIORITY=0
