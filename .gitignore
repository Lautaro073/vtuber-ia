# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
/backup
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tokens de Kick (OAuth)
kick_tokens.json

# estado del live (metas y progreso)
live_state.json

# audio generado por Edge TTS
public/tts/

backups/

# sugerencias anotadas del chat
nyra_suggestions.json

# estado guardado del modo NYRA de agy
scripts/agy-estado.json

# fichas de los amigos del streamer (datos de terceros)
nyra_squad.json

# Whisper local: venv y modelo (se bajan, no se versionan)
.whisper/

# datos que NYRA verificó en internet
nyra_facts.json

# órdenes que el streamer le dio a NYRA por voz
nyra_orders.json

# lo que NYRA aprendió de los pibes y la comunidad (datos de terceros)
nyra_evolution.json

# transcripciones de Discord para pulir Whisper y animaciones que le faltaron
logs/
nyra_wishes.json

# selección local de proveedores/modelos de IA
/nyra_provider_settings.json
/nyra_provider_settings.json.tmp
